# Local toolchain downloads (GnuCOBOL portable build, 7-Zip, shellcheck)
.tools/

# Build products and compiler logs
build/
*.exe
*.o
*.so
*.dylib
*.dll

# Ephemeral test and demo workspaces
.work/
output/*
