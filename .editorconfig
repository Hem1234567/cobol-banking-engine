root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.CBL]
indent_size = 4
trim_trailing_whitespace = false

[*.cpy]
indent_size = 4
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false

[*.sh]
indent_size = 4

[*.py]
indent_size = 4

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2
